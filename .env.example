# Shop an/aus (überschreibt src/data/shop.json → enabled)
# true | false | 1 | 0 | on | off
SHOP_ENABLED=true

# Empfänger für Bestellwünsche
SHOP_ORDER_EMAIL=borris.haering@gmail.com

# Optional: echter E-Mail-Versand via Resend (sonst öffnet sich mailto:)
# RESEND_API_KEY=re_xxx
# SHOP_FROM_EMAIL=Shop <shop@deine-domain.de>

# HMAC-Secret für Shop-Captcha (Token signieren). In Produktion setzen!
# SHOP_CAPTCHA_SECRET=langes-zufaelliges-geheimnis

# --- Auth + Tippspiel (Magic Link, Neon) ---
DATABASE_URL=
AUTH_SECRET=
AUTH_RESEND_KEY=
# Resend: Absender-Name nur ASCII (kein ü). Der Code normalisiert sonst automatisch.
# Zum Testen eine bereits verifizierte Domain, z.B. login@gutachter.tools.
# In Produktion spaeter eine eigene Fuechse-Domain bei Resend eintragen.
EMAIL_FROM="Fuechse Berlin Frauen <login@gutachter.tools>"
# Lokal: diese App liegt auf 3010. Port 3000 ist oft ein anderes Projekt.
# Magic-Links nutzen AUTH_URL als Host. In Produktion die öffentliche URL setzen.
AUTH_URL="http://localhost:3010"
ADMIN_EMAILS="borris.haering@gmail.com"
